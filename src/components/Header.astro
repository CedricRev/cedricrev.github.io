---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { navItems } from "@/data/nav";
import { getPublishedPosts } from "@/lib/blog";

const hasPosts = (await getPublishedPosts()).length > 0;
const items = hasPosts ? [...navItems, { label: "Blog", href: "/blog/" }] : navItems;

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="border-border border-b">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 px-5 py-4 sm:px-8" aria-label="Main">
    <a href="/" class="mr-auto font-mono font-medium">cedric<span class="text-primary">@</span>revestir</a>
    <ul
      id="nav-menu"
      class="order-last hidden w-full flex-col gap-1 pt-3 text-sm data-[open]:flex sm:order-none sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-5 sm:pt-0"
    >
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:before:text-primary block py-2 aria-[current=page]:before:font-mono aria-[current=page]:before:content-['>_'] sm:py-0"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="border-border text-muted-foreground hover:text-foreground rounded border px-2 py-0.5 font-mono text-xs sm:hidden"
        aria-controls="nav-menu"
        aria-expanded="false"
      >
        menu
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "close" : "menu";
    menu?.toggleAttribute("data-open", open);
  });
</script>
