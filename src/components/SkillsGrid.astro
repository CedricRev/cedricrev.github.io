---
import Tag from "@/components/Tag.astro";
import { skills } from "@/data/profile";

const borderClasses = {
  primary: "border-primary",
  sage: "border-sage",
  ochre: "border-ochre",
  plum: "border-plum",
};
const dotClasses = {
  primary: "before:text-primary",
  sage: "before:text-sage",
  ochre: "before:text-ochre",
  plum: "before:text-plum",
};
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
  {
    skills.map((group) => (
      <div class:list={["border-t-3 pt-3", borderClasses[group.tone]]}>
        <h3 class:list={["mb-1.5 font-mono text-sm font-medium before:content-['●_']", dotClasses[group.tone]]}>
          {group.name}
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {group.items.map((item) => (
            <Tag name={item} />
          ))}
        </div>
      </div>
    ))
  }
</div>
