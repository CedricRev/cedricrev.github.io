---
import Tag from "@/components/Tag.astro";
import { experience } from "@/data/profile";
---

<ol class="grid gap-6">
  {
    experience.map((job) => (
      <li class="grid gap-1 sm:grid-cols-[110px_minmax(0,1fr)] sm:gap-4">
        <span class="text-muted-foreground pt-1 font-mono text-xs tabular-nums">
          {job.start && `${job.start} – ${job.end}`}
        </span>
        <div>
          <h3 class="font-semibold">
            {job.role} · {job.company}
          </h3>
          <p class="text-muted-foreground mt-1 mb-2 text-sm">{job.summary}</p>
          <div class="flex flex-wrap gap-1.5">
            {job.tech.map((t) => (
              <Tag name={t} />
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ol>
