---
import { logoOf, toneOf } from "@/data/tech";
import { getDevicon } from "@/lib/icons";

interface Props {
  name: string;
}

const { name } = Astro.props;
const logoName = logoOf(name);
const logo = logoName ? getDevicon(logoName) : undefined;

const toneClasses = {
  primary: "text-primary bg-primary/15",
  sage: "text-sage bg-sage/15",
  ochre: "text-ochre bg-ochre/15",
  plum: "text-plum bg-plum/15",
};
---

<span class:list={["inline-flex items-center gap-1.5 rounded px-2 py-0.5 font-mono text-xs", toneClasses[toneOf(name)]]}>
  {logo && <svg class="size-3.5 shrink-0" viewBox={logo.viewBox} aria-hidden="true" set:html={logo.body} />}
  {name}
</span>
