---
import PathSketch from "@/components/sketches/PathSketch.astro";
import { Button } from "@/components/starwind/button";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found">
  <div class="grid justify-items-start gap-5 py-20">
    <p class="text-muted-foreground font-mono text-sm"><span class="text-primary">~</span> $ cd {Astro.url.pathname}</p>
    <p class="font-mono text-sm text-plum">error: no such page</p>
    <h1 class="font-serif text-4xl font-medium">This path doesn't lead anywhere.</h1>
    <div class="w-32"><PathSketch /></div>
    <Button href="/" variant="primary" size="sm">Back home</Button>
  </div>
</BaseLayout>
