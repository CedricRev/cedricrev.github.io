---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DramaPoster from "@/components/DramaPoster.astro";
import PosterLangToggle from "@/components/PosterLangToggle.astro";
import RatingBar from "@/components/RatingBar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const dramas = await getCollection("kdramas");
  return dramas.map((drama) => ({ params: { id: drama.id }, props: { drama } }));
}

interface Props {
  drama: CollectionEntry<"kdramas">;
}

const { drama } = Astro.props;
const { title, koreanTitle, released, type, episodes, rating, verdict, genres, watched, airing } = drama.data;
const { Content } = await render(drama);
const watchedOn = watched?.toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<BaseLayout title={`${title} (K-drama)`} description={verdict ?? `${title}, a Korean ${type}.`}>
  <a href="/kdramas/" class="text-muted-foreground hover:text-primary mt-10 inline-block font-mono text-sm">
    ← all k-dramas
  </a>
  <article class="grid gap-8 py-8 pb-14 sm:grid-cols-[220px_minmax(0,1fr)] md:gap-12">
    <div class="grid max-w-[220px] content-start gap-3">
      <DramaPoster drama={drama} width={440} eager />
      {drama.data.posterEn && <PosterLangToggle />}
    </div>
    <div class="grid content-start gap-4">
      <div class="grid gap-1">
        <h1 class="font-serif text-4xl font-medium text-balance">{title}</h1>
        {koreanTitle && <p class="text-muted-foreground text-lg">{koreanTitle}</p>}
      </div>
      <p class="text-muted-foreground font-mono text-sm">
        {released.getFullYear()} · {type}{episodes && ` · ${episodes} episodes`}{airing && " · airing"}{watchedOn && ` · watched ${watchedOn}`}
      </p>
      {
        rating !== undefined ? (
          <RatingBar rating={rating} size="md" />
        ) : (
          <span class="text-muted-foreground font-mono">not rated yet</span>
        )
      }
      {
        genres.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {genres.map((genre) => (
              <span class="bg-plum/15 text-plum rounded px-2 py-0.5 font-mono text-xs">{genre}</span>
            ))}
          </div>
        )
      }
      {verdict && <p class="border-primary border-l-3 pl-4 font-serif text-xl italic">{verdict}</p>}
      <div class="grid max-w-[65ch] gap-4 leading-relaxed [&_a]:text-primary [&_a]:underline [&_h2]:mt-4 [&_h2]:font-serif [&_h2]:text-2xl">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
